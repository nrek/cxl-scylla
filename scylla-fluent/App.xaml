<Application
    x:Class="Scylla.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Scylla dark / amber tokens (mirror scyllagpt theme.h) -->
            <Color x:Key="ScyllaAppBg">#0C0F12</Color>
            <Color x:Key="ScyllaPanel">#101317</Color>
            <Color x:Key="ScyllaSurface">#14181D</Color>
            <Color x:Key="ScyllaAmber">#E69405</Color>
            <Color x:Key="ScyllaText">#D7DCE2</Color>
            <!-- Override stock Fluent accent so selection chrome is #e69405 -->
            <Color x:Key="SystemAccentColor">#E69405</Color>
            <Color x:Key="SystemAccentColorLight1">#F0A116</Color>
            <Color x:Key="SystemAccentColorLight2">#EFB65B</Color>
            <Color x:Key="SystemAccentColorLight3">#EFB65B</Color>
            <Color x:Key="SystemAccentColorDark1">#C77F04</Color>
            <Color x:Key="SystemAccentColorDark2">#6E4C0A</Color>
            <Color x:Key="SystemAccentColorDark3">#6E4C0A</Color>
            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource SystemAccentColor}" />
            <SolidColorBrush x:Key="ScyllaAppBgBrush" Color="{StaticResource ScyllaAppBg}" />
            <SolidColorBrush x:Key="ScyllaPanelBrush" Color="{StaticResource ScyllaPanel}" />
            <SolidColorBrush x:Key="ScyllaSurfaceBrush" Color="{StaticResource ScyllaSurface}" />
            <SolidColorBrush x:Key="ScyllaAmberBrush" Color="{StaticResource ScyllaAmber}" />
            <SolidColorBrush x:Key="ScyllaTextBrush" Color="{StaticResource ScyllaText}" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource ScyllaAmber}" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource ScyllaAmber}" />
            <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource ScyllaAmber}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
